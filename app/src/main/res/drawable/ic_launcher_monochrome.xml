            android:strokeLineCap="round" android:pathData="M35,37 L28,33" />
        <path android:strokeColor="#1F1F1F" android:strokeWidth="5"
            android:strokeLineCap="round" android:pathData="M43,29 L39,22" />
        <path android:strokeColor="#1F1F1F" android:strokeWidth="5"
            android:strokeLineCap="round" android:pathData="M54,26 L54,18" />
