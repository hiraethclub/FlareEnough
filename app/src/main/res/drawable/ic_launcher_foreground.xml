<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: a soft dawn. A warm sun rising over a calm horizon on
  the cream background layer. It nods to "flare" through the sun, but gently and
  hopefully, not as an alarm. Kept within the adaptive icon safe zone so the sun is
  never clipped by a mask shape. The horizon may meet the edges, which reads as a
  horizon should. A separate monochrome layer is used for themed icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft rays around the top of the sun. -->
    <group>
        <path android:strokeColor="@color/ic_launcher_sun" android:strokeWidth="5"
            android:strokeLineCap="round" android:pathData="M35,37 L28,33" />
        <path android:strokeColor="@color/ic_launcher_sun" android:strokeWidth="5"
            android:strokeLineCap="round" android:pathData="M43,29 L39,22" />
        <path android:strokeColor="@color/ic_launcher_sun" android:strokeWidth="5"
            android:strokeLineCap="round" android:pathData="M54,26 L54,18" />
        <path android:strokeColor="@color/ic_launcher_sun" android:strokeWidth="5"
            android:strokeLineCap="round" android:pathData="M65,29 L69,22" />
        <path android:strokeColor="@color/ic_launcher_sun" android:strokeWidth="5"
            android:strokeLineCap="round" android:pathData="M73,37 L80,33" />
    </group>

    <!-- The sun. -->
    <path
        android:fillColor="@color/ic_launcher_sun"
        android:pathData="M36,48 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0 Z" />

    <!-- Calm horizon: a sage rise with a soft sky band beneath. -->
    <path
        android:fillColor="@color/ic_launcher_sage"
        android:pathData="M0,76 Q54,66 108,76 L108,90 Q54,80 0,90 Z" />
    <path
        android:fillColor="@color/ic_launcher_sky"
        android:pathData="M0,90 Q54,80 108,90 L108,98 Q54,88 0,98 Z" />
</vector>
