    <!-- About screen. -->
    <string name="about_title">About</string>
    <string name="about_version">Version 0.1.0</string>
    <string name="about_tagline">Free and open source. No ads, no tracking, no accounts.</string>
    <string name="about_licence">Licensed under GPL-3.0, so it and any forks stay free.</string>
    <string name="about_not_medical_title">Not medical advice</string>
    <string name="about_not_medical_body">Flare Enough records and reminds only. It does not diagnose, recommend treatments, adjust doses, check interactions, or interpret symptoms. For medical advice, diagnosis, or treatment, please speak to a healthcare professional.</string>
    <string name="about_privacy_title">Your data stays on your device</string>
    <string name="about_privacy_body">The app has no internet permission and never sends your data anywhere. You are in control of any backup or export.</string>
    <string name="about_author">Made by Aisling de Grás</string>
    <string name="about_contact">aisling@hiraeth.club</string>
    <string name="about_dedication_title">Dedication</string>
    <string name="about_dedication_body">For Emma, my soulmate, who makes the hard days softer.\nFor Max, our son, who shows us the world new again.\nFor Phoebe, loyal and warm, never far from my feet.\nAnd for Imogen and John, who have held me through it all.\nMade with love, and in the hope it helps someone else through their own bad days.</string>

