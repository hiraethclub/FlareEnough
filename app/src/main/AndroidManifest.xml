<?xml version="1.0" encoding="utf-8"?>
<!--
  Flare Enough manifest.

  There is deliberately NO android.permission.INTERNET here. The app works fully
  offline and never transmits data. This is a core promise of the project. Do not
  add the INTERNET permission.

  Permissions needed for reminders (notifications, exact alarms, boot) are added
  in the reminder milestone, each explained to the user before the system prompt.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".FlareApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlareEnough"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FlareEnough">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
