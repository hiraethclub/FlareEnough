<?xml version="1.0" encoding="utf-8"?>
<!--
  Flare Enough manifest.

  There is deliberately NO android.permission.INTERNET here. The app works fully
  offline and never transmits data. This is a core promise of the project. Do not
  add the INTERNET permission.

  Permissions needed for reminders (notifications, exact alarms, boot) are added
  in the reminder milestone, each explained to the user before the system prompt.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Reminder permissions, each explained to the person in the app before the
      system asks. Deliberately NOT here: INTERNET (the app is offline) and
      USE_EXACT_ALARM (Play policy limits that to alarm, timer, and calendar apps,
      which we are not). We use SCHEDULE_EXACT_ALARM, granted by the user.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".FlareApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlareEnough"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FlareEnough">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fires a dose reminder when its alarm goes off. Triggered by our own
             PendingIntent, so it is not exported. -->
        <receiver
            android:name=".reminders.receivers.DoseAlarmReceiver"
            android:exported="false" />

        <!-- Handles Taken, Snooze, and Skip from the notification. -->
        <receiver
            android:name=".reminders.receivers.DoseActionReceiver"
            android:exported="false" />

        <!-- Rebuilds all alarms after reboot, update, and clock or time zone
             changes, and when the exact alarm permission changes. These are all
             protected system broadcasts, so the receiver stays unexported. -->
        <receiver
            android:name=".reminders.receivers.RescheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
